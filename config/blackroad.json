        "description": "Security tooling, auditing, and compliance"
      },
      {
        "name": "BlackRoad-Media",
        "url": "https://github.com/BlackRoad-Media",
        "role": "product",
        "description": "Media production and content systems"
      },
      {
        "name": "BlackRoad-Foundation",
        "url": "https://github.com/BlackRoad-Foundation",
        "role": "governance",
        "description": "Open-source foundation and community governance"
      },
      {
        "name": "BlackRoad-Interactive",
        "url": "https://github.com/BlackRoad-Interactive",
        "role": "product",
        "description": "Interactive experiences and application frontends"
      },
      {
        "name": "BlackRoad-Hardware",
        "url": "https://github.com/BlackRoad-Hardware",
        "role": "product",
        "description": "Hardware design, firmware, and device integration"
      },
      {
        "name": "BlackRoad-Labs",
        "url": "https://github.com/BlackRoad-Labs",
        "role": "research",
        "description": "R&D, prototypes, and experimental projects"
      },
      {
        "name": "BlackRoad-Studio",
        "url": "https://github.com/BlackRoad-Studio",
        "role": "product",
        "description": "Creative studio — design systems and visual tooling"
      },
      {
        "name": "BlackRoad-Ventures",
        "url": "https://github.com/BlackRoad-Ventures",
        "role": "business",
        "description": "Venture operations and portfolio management"
      },
      {
        "name": "BlackRoad-Education",
        "url": "https://github.com/BlackRoad-Education",
        "role": "product",
        "description": "Educational platforms and learning systems"
      },
      {
        "name": "BlackRoad-Gov",
        "url": "https://github.com/BlackRoad-Gov",
        "role": "compliance",
        "description": "Government compliance, regulatory, and public sector"
      },
      {
        "name": "Blackbox-Enterprises",
        "url": "https://github.com/Blackbox-Enterprises",
        "role": "business",
        "description": "Enterprise products and B2B services"
      },
      {
        "name": "BlackRoad-Archive",
        "url": "https://github.com/BlackRoad-Archive",
        "role": "archive",
        "description": "Archived and legacy repositories"
      }
    ]
  },
  "verification": {
    "checks": [
      {
        "id": "org_exists",
        "description": "GitHub organization exists and is accessible",
        "severity": "critical"
      },
      {
        "id": "has_repos",
        "description": "Organization has at least one repository",
        "severity": "warning"
      },
      {
        "id": "recent_activity",
        "description": "At least one commit within the last 90 days",
        "severity": "info"
      },
      {
        "id": "has_readme",
        "description": "Organization profile or primary repo has a README",
        "severity": "warning"
      },
      {
        "id": "ssl_valid",
        "description": "Associated domain has valid SSL certificate",
        "severity": "critical"
      }
    ],
    "thresholds": {
      "critical_pass_rate": 1.0,
      "warning_pass_rate": 0.8,
      "overall_health_minimum": 0.7
    }
  },
  "audit": {
    "schedule": "daily",
    "retention_days": 90,
    "output_path": "audit/output.json",
    "notify_on_failure": true
  }
}
