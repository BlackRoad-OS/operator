{
  "name": "@blackroad-os/operator",
  "version": "0.1.0",
  "description": "BlackRoad OS operator — E2E scraper and cross-repo health monitor",
  "private": true,
  "type": "module",
  "scripts": {
    "scrape": "node scraper/index.js",
    "test": "node --test e2e/*.test.js",
    "test:scraper": "node --test e2e/scraper.test.js",
    "test:readme": "node --test e2e/readme.test.js",
    "test:repos": "node --test e2e/repos.test.js",
    "update": "node scraper/index.js && node scraper/render-readme.js",
    "ci": "npm run scrape && npm test && npm run update"
  },
  "keywords": ["blackroad", "operator", "e2e", "scraper", "monitoring"],
  "license": "SEE LICENSE IN LICENSE"
}
