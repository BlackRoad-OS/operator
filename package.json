{
  "name": "@blackroad/operator",
  "version": "0.1.0",
  "description": "Canonical control plane for the BlackRoad OS platform — remote streaming engine, audit runner, and infrastructure automation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "operator": "bin/operator.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "start": "node dist/cli.js",
    "scrape": "node src/scraper/index.js",
    "verify": "node src/metrics/verify.js",
    "report": "node src/metrics/report.js",
    "audit": "node audit/runner.js",
    "e2e": "node scripts/e2e.js",
    "e2e:run": "node src/e2e/run.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --test --test-concurrency=1 src/e2e/*.test.js",
    "test:e2e:scraper": "node --test e2e/*.test.js",
    "test:all": "node --test --test-concurrency=1 tests/unit/*.test.js src/e2e/*.test.js",
    "ci": "npm run scrape && npm run verify && npm run report && npm run test",
    "dev:terminal": "vite --config src/terminal/vite.config.js",
    "build:terminal": "vite build --config src/terminal/vite.config.js",
    "preview:terminal": "vite preview --config src/terminal/vite.config.js"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.3",
    "vite": "^6.0.0",
    "vitest": "^3.1.1"
  }
}
