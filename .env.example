# GitHub Personal Access Token (requires: repo, read:org, admin:org scopes)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of GitHub organizations to operate on
# Leave empty to auto-discover all orgs the token has access to
OPERATOR_ORGS=

# Streaming configuration
OPERATOR_STREAM_INTERVAL=30000
OPERATOR_STREAM_BATCH_SIZE=100

# Concurrency limits
OPERATOR_CONCURRENCY=10

# Log level: debug | info | warn | error
OPERATOR_LOG_LEVEL=info

# Data directory for local state
OPERATOR_DATA_DIR=.operator

# ---------------------------------------------------------------------------
# OAuth (see config/oauth.yaml)
# ---------------------------------------------------------------------------

# GitHub OAuth App credentials (provider: github)
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Custom / self-hosted OAuth provider credentials (provider: custom)
OAUTH_CUSTOM_AUTHORIZATION_URL=
OAUTH_CUSTOM_TOKEN_URL=
OAUTH_CUSTOM_CLIENT_ID=
OAUTH_CUSTOM_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Vendor API endpoints (see config/vendors.yaml)
# Leave blank to use the default public endpoint for each vendor.
# Set to a self-hosted or proxied URL to route through your own infrastructure.
# ---------------------------------------------------------------------------

VENDOR_GITHUB_ENDPOINT=
VENDOR_CLOUDFLARE_ENDPOINT=
VENDOR_OPENAI_ENDPOINT=
VENDOR_ANTHROPIC_ENDPOINT=
VENDOR_TAILSCALE_ENDPOINT=

# Outbound HTTP proxy for all vendor requests (optional)
# Examples: http://proxy.local:8080  socks5://proxy.local:1080
OPERATOR_HTTP_PROXY=

# ---------------------------------------------------------------------------
# Network (see config/network.yaml)
# ---------------------------------------------------------------------------

# Tailscale auth key — generate at https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY=

# Cloudflare credentials
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_TOKEN=

# Operator HTTP listener
OPERATOR_HOST=127.0.0.1
OPERATOR_PORT=3000

# ---------------------------------------------------------------------------
# Ollama — local AI routing (no external provider dependency)
# All @copilot, @lucidia, and @blackboxprogramming requests are sent here.
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_ALLOWED_ORIGIN=http://localhost:11434
