# GitHub Personal Access Token (requires: repo, read:org, admin:org scopes)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of GitHub organizations to operate on
# Leave empty to auto-discover all orgs the token has access to
OPERATOR_ORGS=

# Streaming configuration
OPERATOR_STREAM_INTERVAL=30000
OPERATOR_STREAM_BATCH_SIZE=100

# Concurrency limits
OPERATOR_CONCURRENCY=10

# Log level: debug | info | warn | error
OPERATOR_LOG_LEVEL=info

# Data directory for local state
OPERATOR_DATA_DIR=.operator

# ── Stripe Integration ──────────────────────────────────────
# Stripe secret key (sk_test_... for dev, sk_live_... for production)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Price ID for the Operator license (from Stripe Dashboard > Products)
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx

# Stripe webhook signing secret (whsec_... from Stripe Dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Site URL for checkout redirects
SITE_URL=https://operator.blackroad.io

# ── License ─────────────────────────────────────────────────
# License key for CLI usage (received after purchase)
OPERATOR_LICENSE_KEY=

# ── Local AI (Raspberry Pi cluster running Ollama) ──────────────
# All @copilot, @lucidia, and @blackboxprogramming requests route here.
# No external AI providers are contacted.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_ALLOWED_ORIGIN=http://localhost:11434

# ── OAuth ───────────────────────────────────────────────────────
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# ── Network ─────────────────────────────────────────────────────
# TAILSCALE_AUTH_KEY=
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=
