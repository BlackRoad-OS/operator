# GitHub Personal Access Token (requires: repo, read:org, admin:org scopes)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of GitHub organizations to operate on
# Leave empty to auto-discover all orgs the token has access to
OPERATOR_ORGS=

# Streaming configuration
OPERATOR_STREAM_INTERVAL=30000
OPERATOR_STREAM_BATCH_SIZE=100

# Concurrency limits
OPERATOR_CONCURRENCY=10

# Log level: debug | info | warn | error
OPERATOR_LOG_LEVEL=info

# Data directory for local state
OPERATOR_DATA_DIR=.operator

# Ollama — local AI routing (no external provider dependency)
# All @copilot, @lucidia, and @blackboxprogramming requests are sent here.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_ALLOWED_ORIGIN=http://localhost:11434
